{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-commit-cs-check.js\"",
            "timeout": 30,
            "statusMessage": "C# スクリプトを検査中..."
          }
        ]
      }
    ]
  }
}
