{
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx tsx tools/scripts/generate-table-docs.ts)",
      "Bash(npx tsx tools/export-to-sql.ts)"
    ],
    "ask": [
      "Bash(*prisma migrate dev*)",
      "Bash(*prisma migrate deploy*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma migrate resolve*)",
      "Bash(*prisma db push*)"
    ]
  }
}
