{
  "name": "{{PROJECT_NAME}}",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // WSL から VS Code を起動した場合のみ HOME が WSL ホームを指す。
  // Windows 側から直接開くと Windows の USERPROFILE になるため、必ず WSL から起動すること。
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      // ⚠️ コンテナ内の Claude Code をバイパスモード（権限プロンプトなし）で起動する設定。
      //    コンテナはホスト側資産（/mnt/c など）から隔離されているため、ブラストラディウスは
      //    ワークスペース内に閉じる、という前提に立っている。
      //    **この前提が成り立たない使い方（ホストの重要ディレクトリを追加マウントする等）を
      //    する場合は、この行を削除すること。**
      //    WSL ホスト側で素の claude を起動した場合はこの設定は適用されず、
      //    毎回確認のデフォルトモードになる。
      "settings": {
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "postCreateCommand": "git config core.autocrlf input && npm install -g @anthropic-ai/claude-code",

  "remoteUser": "node"
}
